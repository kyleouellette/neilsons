# Apache (pitch host). Files in /_astro/ have content hashes in their names,
# so they can be cached forever; everything else revalidates.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|avif|webp|jpe?g|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{REQUEST_URI} =~ m#/_astro/#"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
