---
import BaseLayout from '../layouts/BaseLayout.astro';
import GunOfTheWeek from './GunOfTheWeek.astro';
import Icon from './Icon.astro';
import { hours, reviews, site, specialties } from '../data/site';

const yearsOpen = new Date().getFullYear() - site.established;
---

<BaseLayout>
  <!-- Hero -->
  <section class="topo relative overflow-hidden bg-stone-900 text-white">
    <div class="absolute inset-x-0 bottom-0 h-1.5 bg-blaze-500"></div>
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28 lg:py-32">
      <p class="text-sm font-semibold tracking-[0.25em] text-blaze-400 uppercase">
        {site.town}, {site.state} · Since {site.established}
      </p>
      <h1 class="mt-4 max-w-3xl font-display text-5xl leading-[1.05] font-bold tracking-tight uppercase sm:text-6xl lg:text-7xl">
        Maine's hunting <span class="text-blaze-500">headquarters</span> for {yearsOpen}+ years.
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-stone-300">
        New and used rifles, shotguns and handguns. Reloading supplies. Blackpowder. And straight answers from folks
        who actually hunt.
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href="#gun-of-the-week"
          class="rounded-md bg-blaze-500 px-6 py-3 font-semibold text-white shadow-lg shadow-blaze-900/30 transition-colors hover:bg-blaze-600"
          >See this week's featured gun</a
        >
        <a
          href="#visit"
          class="rounded-md border border-stone-600 px-6 py-3 font-semibold text-stone-100 transition-colors hover:border-blaze-400 hover:text-blaze-300"
          >Plan a visit</a
        >
      </div>
    </div>
  </section>

  <GunOfTheWeek />

  <!-- What we carry -->
  <section id="what-we-carry" class="scroll-mt-20 py-16 sm:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <p class="text-sm font-semibold tracking-widest text-blaze-600 uppercase dark:text-blaze-400">What we carry</p>
      <h2 class="mt-2 max-w-2xl font-display text-4xl font-bold tracking-tight uppercase sm:text-5xl">
        Quality new & used firearms for whatever you're after
      </h2>
      <p class="mt-4 max-w-2xl text-stone-600 dark:text-stone-400">
        Handgun or long gun, first rifle or fiftieth, there's something on the rack that fits how you hunt and shoot.
      </p>

      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          specialties.map((s) => (
            <li class="group rounded-xl border border-stone-200 bg-white p-6 transition-shadow hover:shadow-lg dark:border-stone-800 dark:bg-stone-900">
              <span class="grid size-12 place-items-center rounded-lg bg-blaze-100 text-blaze-700 transition-colors group-hover:bg-blaze-500 group-hover:text-white dark:bg-blaze-900/40 dark:text-blaze-300">
                <Icon name={s.icon} />
              </span>
              <h3 class="mt-4 font-display text-xl font-semibold tracking-wide uppercase">{s.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-stone-600 dark:text-stone-400">{s.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Reloading & Blackpowder -->
  <section id="reloading" class="scroll-mt-20 bg-stone-100 py-16 sm:py-24 dark:bg-stone-900">
    <div class="mx-auto grid max-w-6xl gap-6 px-4 sm:px-6 md:grid-cols-2">
      <div class="rounded-2xl bg-white p-8 shadow-sm dark:bg-stone-950">
        <span class="text-blaze-600 dark:text-blaze-400"><Icon name="box" class="size-10" /></span>
        <h2 class="mt-4 font-display text-3xl font-bold tracking-tight uppercase">Reloading Supplies</h2>
        <p class="mt-3 text-stone-600 dark:text-stone-400">
          An excellent source for everything on the bench and the tools to get the job done right.
        </p>
        <ul class="mt-6 grid grid-cols-2 gap-2 text-sm font-medium">
          {
            ['Powder', 'Brass', 'Bullets', 'Dies', 'Presses', 'Tools'].map((i) => (
              <li class="flex items-center gap-2">
                <span class="size-1.5 rounded-full bg-blaze-500" />
                {i}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="rounded-2xl bg-white p-8 shadow-sm dark:bg-stone-950">
        <span class="text-blaze-600 dark:text-blaze-400"><Icon name="flame" class="size-10" /></span>
        <h2 class="mt-4 font-display text-3xl font-bold tracking-tight uppercase">Blackpowder</h2>
        <p class="mt-3 text-stone-600 dark:text-stone-400">
          An extensive line of muzzleloading rifles and everything that goes with them for the late season.
        </p>
        <ul class="mt-6 grid grid-cols-2 gap-2 text-sm font-medium">
          {
            ['Rifles', 'Bullets', 'Sabots', 'Powder', 'Equipment', 'Accessories'].map((i) => (
              <li class="flex items-center gap-2">
                <span class="size-1.5 rounded-full bg-blaze-500" />
                {i}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- About Gary -->
  <section class="py-16 sm:py-24">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 sm:px-6 lg:grid-cols-2">
      <div>
        <p class="text-sm font-semibold tracking-widest text-blaze-600 uppercase dark:text-blaze-400">Meet the owner</p>
        <h2 class="mt-2 font-display text-4xl font-bold tracking-tight uppercase sm:text-5xl">{site.owner}</h2>
        <p class="mt-4 text-lg leading-relaxed text-stone-700 dark:text-stone-300">
          Gary brings a wealth of knowledge in outdoor sporting activities, and he's no stranger to firearms. Ask him
          about the <strong class="text-stone-900 dark:text-white">Cooper Arms One Shot</strong> trophies on display
          in the showroom.
        </p>
        <p class="mt-4 text-stone-600 dark:text-stone-400">
          Whether you're picking out a first deer rifle, working up a load, or getting a muzzleloader ready for the
          late season, you'll get advice from someone who's been there.
        </p>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div class="rounded-2xl bg-blaze-500 p-6 text-white">
          <p class="font-display text-5xl font-bold">{site.established}</p>
          <p class="mt-1 text-sm text-blaze-100">Serving hunters & fishermen</p>
        </div>
        <div class="rounded-2xl bg-stone-900 p-6 text-white dark:bg-stone-800">
          <p class="font-display text-5xl font-bold">{yearsOpen}+</p>
          <p class="mt-1 text-sm text-stone-400">Years in Farmingdale</p>
        </div>
        <div class="col-span-2 rounded-2xl border border-stone-200 p-6 dark:border-stone-800">
          <p class="font-display text-2xl font-semibold uppercase">New · Used · Handgun · Long gun</p>
          <p class="mt-1 text-sm text-stone-600 dark:text-stone-400">
            Upland, waterfowl, turkey, big game, small game, skeet, target and protection.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Reviews / Yelp -->
  <section class="topo bg-stone-900 py-16 text-white sm:py-20">
    <div class="mx-auto flex max-w-4xl flex-col items-center px-4 text-center sm:px-6">
      <div class="flex gap-1 text-blaze-500">
        {Array.from({ length: 5 }).map(() => <Icon name="star" class="size-7" />)}
      </div>
      <h2 class="mt-4 font-display text-4xl font-bold tracking-tight uppercase sm:text-5xl">Had a good visit?</h2>
      <p class="mt-4 max-w-xl text-lg text-stone-300">
        Word of mouth has kept us going since {site.established}. If we helped you find the right gun or the right
        load, we'd be grateful if you shared it on Yelp.
      </p>
      <ul class="mt-10 grid w-full gap-5 text-left sm:grid-cols-2">
        {
          reviews.map((r) => (
            <li>
              <figure class="flex h-full flex-col rounded-xl border border-stone-700 bg-stone-950/60 p-6">
                <blockquote class="flex-1 leading-relaxed text-stone-200">“{r.body}”</blockquote>
                <figcaption class="mt-4 text-sm">
                  <span class="font-semibold text-white">{r.author}</span>
                  <span class="text-stone-400"> · {r.date}</span>
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
      <a
        href={site.yelpUrl}
        target="_blank"
        rel="noopener"
        class="mt-10 rounded-md bg-blaze-500 px-6 py-3 font-semibold text-white shadow-lg shadow-black/30 transition-colors hover:bg-blaze-600"
        >Leave us a review on Yelp</a
      >
    </div>
  </section>

  <!-- Visit -->
  <section id="visit" class="scroll-mt-20 py-16 sm:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="overflow-hidden rounded-2xl border border-stone-200 bg-white md:grid md:grid-cols-2 dark:border-stone-800 dark:bg-stone-900">
        <div class="p-8 sm:p-10">
          <p class="text-sm font-semibold tracking-widest text-blaze-600 uppercase dark:text-blaze-400">Visit the shop</p>
          <h2 class="mt-2 font-display text-4xl font-bold tracking-tight uppercase">{site.town}, {site.state}</h2>
          <p class="mt-2 text-stone-600 dark:text-stone-400">{site.locationNote} in Augusta.</p>
          <ul class="mt-6 space-y-4 text-stone-700 dark:text-stone-300">
            <li class="flex items-start gap-3">
              <span class="mt-0.5 text-blaze-600 dark:text-blaze-400"><Icon name="pin" /></span>
              <address class="not-italic">
                {site.address.street}<br />
                {site.address.city}, {site.address.state} {site.address.zip}
              </address>
            </li>
            <li class="flex items-center gap-3">
              <span class="text-blaze-600 dark:text-blaze-400"><Icon name="phone" /></span>
              <a href={site.phoneHref} class="font-medium hover:text-blaze-600 dark:hover:text-blaze-400">{site.phone}</a>
            </li>
            <li class="flex items-center gap-3">
              <span class="text-blaze-600 dark:text-blaze-400"><Icon name="mail" /></span>
              <a href={`mailto:${site.email}`} class="font-medium break-all hover:text-blaze-600 dark:hover:text-blaze-400"
                >{site.email}</a
              >
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-0.5 text-blaze-600 dark:text-blaze-400"><Icon name="clock" /></span>
              <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1">
                {
                  hours.map((h) => (
                    <>
                      <dt class="font-medium">{h.days}</dt>
                      <dd>{h.time}</dd>
                    </>
                  ))
                }
              </dl>
            </li>
          </ul>
          <p class="mt-4 text-stone-600 dark:text-stone-400">
            Stop in to handle a rifle, talk loads, or just swap stories about the one that got away.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href={site.mapsUrl}
              target="_blank"
              rel="noopener"
              class="inline-block rounded-md bg-blaze-500 px-6 py-3 font-semibold text-white transition-colors hover:bg-blaze-600"
              >Get directions</a
            >
            <a
              href={site.phoneHref}
              class="inline-block rounded-md border border-stone-300 px-6 py-3 font-semibold transition-colors hover:border-blaze-500 hover:text-blaze-600 dark:border-stone-700 dark:hover:text-blaze-400"
              >Call the shop</a
            >
          </div>
        </div>
        <div class="topo flex min-h-56 items-center justify-center bg-stone-900 p-8">
          <div class="text-center">
            <p class="font-display text-6xl font-bold text-blaze-500">N</p>
            <p class="mt-2 font-display text-2xl tracking-widest text-white uppercase">{site.name}</p>
            <p class="mt-1 text-sm tracking-widest text-stone-400 uppercase">Est. {site.established}</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
