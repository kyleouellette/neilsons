---
import { hours, site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="border-t-4 border-blaze-500 bg-stone-900 text-stone-400">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:grid-cols-3 sm:px-6">
    <div>
      <p class="font-display text-lg font-semibold tracking-wide text-white uppercase">{site.name}</p>
      <p class="mt-2 text-sm">{site.tagline}</p>
    </div>
    <div class="text-sm">
      <p class="font-semibold text-stone-200">Find us</p>
      <address class="mt-2 not-italic">
        {site.address.street}<br />
        {site.address.city}, {site.address.state} {site.address.zip}
      </address>
      <p class="mt-1">
        <a href={site.phoneHref} class="inline-block py-1.5 hover:text-white">{site.phone}</a><br />
        <a href={`mailto:${site.email}`} class="inline-block py-1.5 break-all hover:text-white">{site.email}</a>
      </p>
      <a href={site.mapsUrl} target="_blank" rel="noopener" class="inline-block py-1.5 text-blaze-400 hover:text-blaze-300"
        >Get directions →</a
      >
      <p class="mt-4 font-semibold text-stone-200">Hours</p>
      <dl class="mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-0.5">
        {
          hours.map((h) => (
            <>
              <dt>{h.days}</dt>
              <dd>{h.time}</dd>
            </>
          ))
        }
      </dl>
    </div>
    <div class="text-sm">
      <p class="font-semibold text-stone-200">Been in?</p>
      <p class="mt-2">Tell other hunters about your visit.</p>
      <a href={site.yelpUrl} target="_blank" rel="noopener" class="mt-1 inline-block py-1.5 text-blaze-400 hover:text-blaze-300"
        >Review us on Yelp →</a
      >
    </div>
  </div>
  <div class="border-t border-stone-800 py-4 text-center text-xs">
    © {year} {site.name}. All firearm sales subject to federal, state and local law.
  </div>
</footer>
