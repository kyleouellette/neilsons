<button
  type="button"
  data-theme-toggle
  class="rounded-md p-2 text-stone-600 transition-colors hover:bg-stone-200 hover:text-blaze-700 dark:text-stone-300 dark:hover:bg-stone-800 dark:hover:text-blaze-400"
  aria-label="Toggle dark mode"
>
  <!-- sun (shown in dark mode) -->
  <svg class="hidden size-5 dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <circle cx="12" cy="12" r="4"></circle>
    <path
      stroke-linecap="round"
      d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
    ></path>
  </svg>
  <!-- moon (shown in light mode) -->
  <svg class="size-5 dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linejoin="round" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
  </svg>
</button>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) =>
    btn.addEventListener('click', () => {
      const dark = document.documentElement.classList.toggle('dark');
      try {
        localStorage.setItem('theme', dark ? 'dark' : 'light');
      } catch {}
    }),
  );
</script>
