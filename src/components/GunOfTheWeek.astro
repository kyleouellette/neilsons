---
import { Picture } from 'astro:assets';
import { getCollection, render } from 'astro:content';

// Guns dated after the build day (in Maine) stay hidden until a later build.
// `npm run dev` shows them so queued weeks can be previewed.
const today = new Date().toLocaleDateString('en-CA', { timeZone: 'America/New_York' }); // YYYY-MM-DD
const isoDay = (d: Date) => d.toISOString().slice(0, 10);

const guns = (await getCollection('guns', ({ data }) => import.meta.env.DEV || isoDay(data.weekOf) <= today)).sort(
  (a, b) => b.data.weekOf.getTime() - a.data.weekOf.getTime(),
);
const [current, ...rest] = guns;
const gun = current?.data;
const previous = rest.slice(0, 3).map((g) => g.data);
const { Content } = current ? await render(current) : { Content: null };

// weekOf is parsed as UTC midnight, so format in UTC to keep the same calendar day
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---

{gun && Content && (
<section id="gun-of-the-week" class="scroll-mt-20 bg-white py-16 sm:py-24 dark:bg-stone-900">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-sm font-semibold tracking-widest text-blaze-700 uppercase dark:text-blaze-400">
          Gun of the Week
        </p>
        <h2 class="mt-2 font-display text-4xl font-bold tracking-tight uppercase sm:text-5xl">
          {gun.make} <span class="text-blaze-700 dark:text-blaze-400">{gun.model}</span>
        </h2>
      </div>
      <p class="text-sm text-stone-500 dark:text-stone-400">Week of {fmt(gun.weekOf)}</p>
    </div>

    <div class="mt-10 grid gap-10 lg:grid-cols-5">
      {/* Photo / illustration card */}
      <div
        class="topo relative flex aspect-[4/3] items-center justify-center self-start overflow-hidden rounded-2xl bg-stone-900 lg:col-span-3"
        style={gun.image && `aspect-ratio: ${gun.image.src.width} / ${gun.image.src.height}`}
      >
        {
          gun.image ? (
            <Picture
              src={gun.image.src}
              alt={gun.image.alt}
              formats={['avif', 'webp']}
              widths={[480, 800, 1200, 1600]}
              sizes="(min-width: 1152px) 650px, (min-width: 1024px) 57vw, 100vw"
              loading="lazy"
              decoding="async"
              class="absolute inset-0 size-full object-cover"
            />
          ) : (
            <svg viewBox="0 0 600 140" class="w-full p-6 text-stone-200" aria-hidden="true">
              <g fill="currentColor">
                <rect x="250" y="46" width="340" height="9" rx="3" />
                <rect x="215" y="36" width="140" height="14" rx="6" class="text-stone-400" fill="currentColor" />
                <rect x="222" y="30" width="18" height="10" rx="2" />
                <rect x="330" y="30" width="18" height="10" rx="2" />
                <path
                  d="M40 70 L200 52 H420 Q430 52 428 62 L420 72 H300 L268 78 Q250 84 240 98 L150 112 Q120 118 70 116 L20 116 Q8 116 10 104 L18 82 Q22 72 40 70Z"
                  class="text-blaze-700"
                  fill="currentColor"
                />
                <path d="M262 72 q2 22 -6 26 q-8 2 -10 -6 q0 -8 4 -18Z" class="text-stone-400" fill="currentColor" />
                <circle cx="300" cy="50" r="5" />
                <rect x="296" y="50" width="4" height="20" transform="rotate(30 298 52)" />
              </g>
            </svg>
          )
        }
        {gun.condition && <span
          class="absolute top-4 left-4 rounded-full bg-blaze-500 px-3 py-1 text-xs font-bold tracking-wider text-stone-950 uppercase shadow"
          >{gun.condition}</span
        >}
        <p
          class="absolute right-4 bottom-4 rounded bg-stone-950/70 px-2 py-1 font-display text-sm tracking-widest text-stone-200 uppercase"
        >
          {gun.caliber}
        </p>
      </div>

      {/* Details */}
      <div class="flex flex-col lg:col-span-2">
        <div class="space-y-4 text-lg leading-relaxed text-stone-700 dark:text-stone-300"><Content /></div>

        <dl class="mt-6 grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-stone-200 bg-stone-200 dark:border-stone-700 dark:bg-stone-700">
          {
            [{ label: 'Caliber', value: gun.caliber }, ...(gun.action ? [{ label: 'Action', value: gun.action }] : []), ...gun.specs].map((s) => (
              <div class="bg-stone-50 p-3 dark:bg-stone-900">
                <dt class="text-xs tracking-wider text-stone-500 uppercase dark:text-stone-400">{s.label}</dt>
                <dd class="mt-1 font-semibold">{s.value}</dd>
              </div>
            ))
          }
        </dl>

        <div class="mt-6">
          <p class="text-xs font-semibold tracking-wider text-stone-500 uppercase dark:text-stone-400">Good for</p>
          <ul class="mt-2 flex flex-wrap gap-2">
            {
              gun.goodFor.map((g) => (
                <li class="rounded-full border border-blaze-300 bg-blaze-50 px-3 py-1 text-sm text-blaze-800 dark:border-blaze-800 dark:bg-blaze-900/30 dark:text-blaze-200">
                  {g}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="mt-8 flex flex-wrap items-center gap-4 lg:mt-auto lg:pt-8">
          <p class="font-display text-3xl font-bold">{gun.price ?? 'Call for price'}</p>
          <a
            href="#visit"
            class="rounded-md bg-blaze-500 px-5 py-3 font-semibold text-stone-950 shadow-sm transition-colors hover:bg-blaze-600"
            >Come see it in person</a
          >
        </div>
      </div>
    </div>

    {
      previous.length > 0 && (
        <div class="mt-14">
          <p class="text-xs font-semibold tracking-wider text-stone-500 uppercase dark:text-stone-400">
            Previously featured
          </p>
          <ul class="mt-3 grid gap-3 sm:grid-cols-3">
            {previous.map((p) => (
              <li class="rounded-lg border border-stone-200 p-4 dark:border-stone-700">
                <p class="text-xs text-stone-500 dark:text-stone-400">{fmt(p.weekOf)}</p>
                <p class="mt-1 font-semibold">
                  {p.make} {p.model}
                </p>
                <p class="text-sm text-stone-600 dark:text-stone-400">{p.caliber}</p>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</section>
)}
