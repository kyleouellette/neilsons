---
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  { href: `${base}/#gun-of-the-week`, label: 'Gun of the Week' },
  { href: `${base}/#what-we-carry`, label: 'What We Carry' },
  { href: `${base}/#reloading`, label: 'Reloading' },
  { href: `${base}/#visit`, label: 'Visit' },
];
---

<header
  class="sticky top-0 z-40 border-b border-stone-200 bg-stone-50/90 backdrop-blur dark:border-stone-800 dark:bg-stone-950/90"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href={`${base}/`} class="group flex items-center gap-3">
      <span
        class="grid size-10 place-items-center rounded-md bg-blaze-500 font-display text-2xl font-bold text-white shadow-sm"
        aria-hidden="true">N</span
      >
      <span class="leading-tight">
        <span class="block font-display text-xl font-semibold tracking-wide uppercase">{site.shortName}</span>
        <span class="block text-xs tracking-widest text-stone-500 uppercase dark:text-stone-400"
          >Sporting Goods · Est. {site.established}</span
        >
      </span>
    </a>

    <nav class="hidden items-center gap-6 md:flex" aria-label="Main">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="text-sm font-medium text-stone-600 transition-colors hover:text-blaze-600 dark:text-stone-300 dark:hover:text-blaze-400"
          >
            {l.label}
          </a>
        ))
      }
      <ThemeToggle />
    </nav>

    <div class="flex items-center gap-2 md:hidden">
      <ThemeToggle />
      <button
        id="menu-btn"
        type="button"
        class="rounded-md p-2 text-stone-700 hover:bg-stone-200 dark:text-stone-200 dark:hover:bg-stone-800"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Open menu"
      >
        <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="hidden border-t border-stone-200 md:hidden dark:border-stone-800" aria-label="Mobile">
    <ul class="mx-auto max-w-6xl px-4 py-2">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class="block rounded-md px-2 py-3 font-medium text-stone-700 hover:bg-stone-200 dark:text-stone-200 dark:hover:bg-stone-800"
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const btn = document.getElementById('menu-btn')!;
  const menu = document.getElementById('mobile-menu')!;
  const setOpen = (open: boolean) => {
    menu.classList.toggle('hidden', !open);
    btn.setAttribute('aria-expanded', String(open));
  };
  btn.addEventListener('click', () => setOpen(menu.classList.contains('hidden')));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
</script>
