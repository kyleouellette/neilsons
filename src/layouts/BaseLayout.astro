---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import interFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import oswaldFont from '@fontsource-variable/oswald/files/oswald-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  /** Omit the site header and footer (e.g. the under-construction page) */
  bare?: boolean;
}

const {
  bare = false,
  title = `${site.name} | Firearms, Reloading & Hunting Gear in ${site.town}, ME`,
  description = `New and used rifles, shotguns and handguns, reloading supplies and blackpowder in ${site.town}, ${site.state}. Serving hunters since ${site.established}.`,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site);

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'SportingGoodsStore',
  name: site.name,
  url: Astro.site?.href,
  telephone: site.phone,
  email: site.email,
  foundingDate: String(site.established),
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.state,
    postalCode: site.address.zip,
    addressCountry: 'US',
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#1c1917" />
    <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
    <link rel="preload" href={interFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={oswaldFont} as="font" type="font/woff2" crossorigin />

    <!-- Apply the saved / system theme before paint to avoid a flash -->
    <script is:inline>
      (() => {
        let theme;
        try { theme = localStorage.getItem('theme'); } catch {}
        if (!theme) theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.classList.toggle('dark', theme === 'dark');
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col font-sans">
    {
      !bare && (
        <a
          href="#main"
          class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-blaze-500 focus:px-4 focus:py-2 focus:text-stone-950"
        >
          Skip to content
        </a>
      )
    }
    {!bare && <Header />}
    <main id="main" class="flex-1">
      <slot />
    </main>
    {!bare && <Footer />}
  </body>
</html>
